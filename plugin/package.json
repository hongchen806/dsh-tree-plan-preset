{
  "name": "@local/dsh-tree-plan-preset",
  "version": "2.1.0-stable",
  "private": true,
  "type": "module",
  "description": "Tree planning 2.1-stable: cache-first PTC preset with inline editing, undo, zoom, pan, merge groups, and execution status.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node tests/test-client.cjs && node tests/test-host.cjs"
  },
  "files": [
    "index.js",
    "client.js",
    "tree-parser.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
